{
  "name": "open-learning-hub",
  "version": "2.0.0-draft",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/preserve-legacy.mjs && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint:python && npm run test && npm run coverage:python && npm run verify:python && npm run build",
    "format": "prettier --write src scripts tests *.ts *.json *.html docs/*.md .github/workflows/*.yml",
    "prepare:python": "node scripts/prepare-python.mjs",
    "predev": "npm run prepare:python",
    "prebuild": "npm run prepare:python",
    "verify:python": "npm run prepare:python && node --experimental-strip-types scripts/verify-python.mjs",
    "lint:python": "eslint src/python public/python-worker.js scripts/*python*.mjs tests/python.test.ts tests/e2e/python.spec.ts",
    "coverage:python": "node --experimental-strip-types scripts/python-coverage.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@uiw/react-codemirror": "4.25.2",
    "lucide-react": "0.468.0",
    "pyodide": "0.27.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
